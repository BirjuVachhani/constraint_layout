# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
# This repo is a pub workspace, so a single lock file lives at the root;
# the unanchored pattern also covers any lock file in workspace members.
pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies

# Build artifacts and coverage, in the root package and all workspace
# members (packages/, website/, etc.).
build/
coverage/

# Local-only directories, excluded from VCS entirely
inspo/
playground/
